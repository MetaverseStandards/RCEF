# SPDX-License-Identifier: CC-BY-SA-4.0
# Written by tools/calibration/k4_mediapipe.py. Everything but cells was frozen, and its hash written to
# calibration/FREEZES, before the held-out run.
format = "rcef.calibration/1"
id = "mediapipe.ict-response"
version = 1
status = "calibrated_software"
scope = "software-only; not a measurement of any tracker"
scan_origin = "ICT-FaceKit's identity modes are principal components of light-stage scans of real people; they are used here only as geometry, through 10 modes drawn from a standard normal."
method = "inverse_monotone_median_fit: for each channel, the median MediaPipe score at each swept weight over the training conditions, made nondecreasing (pool-adjacent-violators), then inverted to a score-to-weight curve by linear interpolation; a flat stretch keeps its lowest weight; scores below the first or above the last median map to 0 and 1. Cell errors are |curve(score) - weight| over every swept weight of the first conditions held-out conditions; neutral is the median error at weight 0; a condition in which MediaPipe finds no face at any weight is a failure."
channels = ["mediapipe.score.browDownLeft", "mediapipe.score.browDownRight", "mediapipe.score.browInnerUp", "mediapipe.score.browOuterUpLeft", "mediapipe.score.browOuterUpRight", "mediapipe.score.eyeBlinkLeft", "mediapipe.score.eyeBlinkRight", "mediapipe.score.eyeLookDownLeft", "mediapipe.score.eyeLookDownRight", "mediapipe.score.eyeLookInRight", "mediapipe.score.eyeLookOutLeft", "mediapipe.score.eyeSquintLeft", "mediapipe.score.eyeSquintRight", "mediapipe.score.jawOpen", "mediapipe.score.mouthFunnel", "mediapipe.score.mouthLeft", "mediapipe.score.mouthPressLeft", "mediapipe.score.mouthPucker", "mediapipe.score.mouthRight", "mediapipe.score.mouthRollLower", "mediapipe.score.mouthShrugLower", "mediapipe.score.mouthShrugUpper", "mediapipe.score.mouthSmileLeft", "mediapipe.score.mouthSmileRight", "mediapipe.score.mouthStretchRight"]
reference_rig = "ICT-FaceKit Light da5f95a: generic neutral head and 53 expression shapes, with identity modes 0-9"
code_commit = "827e35b2773eb120061af7238cae20ce11ac5341"
licence = "CC-BY-SA-4.0"
limitations = [
  "Software-only: this is MediaPipe's response to untextured ICT renders. It says nothing about MediaPipe on real faces or photographs, or about any tracker.",
  "MediaPipe's blendshape model learned expressions transferred from an artist-designed base mesh (its model card), and ICT-FaceKit's shapes follow the same artist-made ARKit conventions, so agreement here may partly reflect those shared conventions rather than an independent measurement.",
  "Each channel was swept alone from a neutral face; combinations of expressions, which change MediaPipe's scores, were not measured.",
  "Renders are grey Lambert surfaces with no texture, eyelashes, eyebrows or skin detail.",
  "Held-out ICT identities vary only ICT's first 10 identity modes.",
  "The curves invert MediaPipe's median response on ICT; a rig with different shapes needs its own check, which is what the Rocketbox cells test.",
  "No curve was fitted for cheekPuff (the median score rises only 0.000 from weight 0 to 1); cheekSquintLeft (the median score rises only 0.000 from weight 0 to 1); cheekSquintRight (the median score rises only 0.000 from weight 0 to 1); eyeLookInLeft (the median score rises only 0.064 from weight 0 to 1); eyeLookOutRight (the median score rises only 0.050 from weight 0 to 1); eyeLookUpLeft (the median score rises only 0.076 from weight 0 to 1); eyeLookUpRight (the median score rises only 0.047 from weight 0 to 1); eyeWideLeft (the median score rises only 0.004 from weight 0 to 1); eyeWideRight (the median score rises only 0.003 from weight 0 to 1); jawForward (the median score rises only 0.000 from weight 0 to 1); jawLeft (the median score rises only 0.004 from weight 0 to 1); jawRight (the median score rises only 0.000 from weight 0 to 1); mouthClose (the median score rises only 0.000 from weight 0 to 1); mouthDimpleLeft (the median score rises only 0.044 from weight 0 to 1); mouthDimpleRight (the median score rises only 0.032 from weight 0 to 1); mouthFrownLeft (the median score rises only 0.003 from weight 0 to 1); mouthFrownRight (the median score rises only 0.006 from weight 0 to 1); mouthLowerDownLeft (the median score rises only 0.002 from weight 0 to 1); mouthLowerDownRight (the median score rises only 0.002 from weight 0 to 1); mouthPressRight (the median score rises only 0.071 from weight 0 to 1); mouthRollUpper (the median score rises only 0.049 from weight 0 to 1); mouthStretchLeft (the median score rises only 0.071 from weight 0 to 1); mouthUpperUpLeft (the median score rises only 0.040 from weight 0 to 1); mouthUpperUpRight (the median score rises only 0.054 from weight 0 to 1); noseSneerLeft (the median score rises only 0.000 from weight 0 to 1); noseSneerRight (the median score rises only 0.000 from weight 0 to 1).",
]

