sha256 = "55771cbbcffb8204dcfe450784c8439ee27bfa48efffc48d325b55ee4bd04388"

[renderer]
source_sha256 = "8664a0da0e7638d5aa0cfdd79ae62db3db1912020ce85f1924dbef988b77ef82"
binary_sha256 = "305b3e2e48b44fc8394d62b6ec4e89e549c98298a75410679b05810b33fae0f1"
compiler = "Apple Swift version 6.3.3 (swiftlang-6.3.3.1.3 clang-2100.1.1.101)"
os = "macOS 27.0.1 (arm64)"
gpu = "Apple M4 Max"

[training]
conditions = 24
description = "24 conditions, each on its own ICT identity (10 modes from a standard normal), from seeds rcef.k4.training:0 to :23; head yaw within +-15 degrees, pitch +-10 and roll +-5; camera distance 0.9 to 1.2 of the framing distance and vertical field of view 25 to 35 degrees; key light pitch -0.8 to 0.1 rad and yaw +-0.8 rad, key 600 to 1100 and ambient 150 to 400; grey level 0.55 to 0.85 on a 0.05 to 0.3 background; 512 x 512 renders. Every channel is swept alone at each condition."

[held_out]
seed_rule = "rcef.calibration.seeds/1"
count = 20
frozen_sha256 = "bf10b92b55476dd550fb9882e0c7427d9e4ddda05af0cd3e143ddf05ce62ff22"

[evaluation]
min_conditions = 20

