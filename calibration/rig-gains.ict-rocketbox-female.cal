[renderer]
source_sha256 = "913c16416a147c0f8c19e18325a52aecbe7d86e90a3d7920a7bf6efb78addea0"
binary_sha256 = "60e618ff15c61605ceec5721e9f884d82155ae634eee2a3118dc024cf90e13bf"
compiler = "Apple Swift version 6.3.3 (swiftlang-6.3.3.1.3 clang-2100.1.1.101)"
os = "macOS 27.0.1 (arm64)"
gpu = "Apple M4 Max"

[training]
conditions = 24
description = "Per channel: ICT identities 1-8 (generic neutral plus ten identity modes, coefficients standard normal from SHA-256 of \"rcef.k3.identity:<j>:<i>\"), 3 cameras each (yaw +-30, pitch +-15 degrees, distance x0.92-1.08, vertical field of view 26-34 degrees, aim offset +-0.05 IOD, from SHA-256 of \"rcef.k3.train:<channel>:<j>:<k>\"), ICT weights 0.25, 0.5, 0.75 and 1; Rocketbox Female rendered at weights 0 to 1 in steps of 1/8. Knots: median best Rocketbox weight per ICT weight, pool-adjacent-violators, [0, 0] first. Held out: ICT identity 0, one condition per seed (camera and an ICT weight in [0.2, 1] from SHA-256 of \"rcef.k3.heldout:<seed>:<channel>\"). A condition is a failure if fewer than half the region markers (or 3) are visible, ICT moves under 0.5 px, Rocketbox at its best weight explains under half of ICT's motion, or Rocketbox at weight 1 reaches under 1/1.05 of it. Error: |curve(w) - best Rocketbox weight|. Constants and code: examples/rig_gains.py at code_commit; landmarks: examples/data/rig_landmarks.json."

[held_out]
seed_rule = "rcef.calibration.seeds/1"
count = 24
frozen_sha256 = "18afee0a4da98aac15e4ae2a33fb06a3ee4153525d26e49b510f108dff06a5f5"

[evaluation]
min_conditions = 24

