# SPDX-License-Identifier: CC-BY-SA-4.0
# RCEF calibration record (format: calibration/README.md).
format = "rcef.calibration/1"
id = "rig-gains.ict-rocketbox-female"
version = 2
status = "calibrated_software"
scope = "software-only; not a measurement of any tracker"
scan_origin = "ICT-FaceKit identity modes are principal components of light-stage scans of real people. This fit uses the first ten only as geometry, with synthetic coefficient vectors; no images or identifiers of any person are used."
method = "landmark_monotone_fit"
channels = ["arkit.coefficient.browDownLeft", "arkit.coefficient.browDownRight", "arkit.coefficient.browInnerUp", "arkit.coefficient.browOuterUpLeft", "arkit.coefficient.browOuterUpRight", "arkit.coefficient.cheekPuff", "arkit.coefficient.cheekSquintLeft", "arkit.coefficient.cheekSquintRight", "arkit.coefficient.eyeBlinkLeft", "arkit.coefficient.eyeBlinkRight", "arkit.coefficient.eyeLookDownLeft", "arkit.coefficient.eyeLookDownRight", "arkit.coefficient.eyeLookInLeft", "arkit.coefficient.eyeLookInRight", "arkit.coefficient.eyeLookOutLeft", "arkit.coefficient.eyeLookOutRight", "arkit.coefficient.eyeLookUpLeft", "arkit.coefficient.eyeLookUpRight", "arkit.coefficient.eyeSquintLeft", "arkit.coefficient.eyeSquintRight", "arkit.coefficient.eyeWideLeft", "arkit.coefficient.eyeWideRight", "arkit.coefficient.jawForward", "arkit.coefficient.jawLeft", "arkit.coefficient.jawOpen", "arkit.coefficient.jawRight", "arkit.coefficient.mouthClose", "arkit.coefficient.mouthDimpleLeft", "arkit.coefficient.mouthDimpleRight", "arkit.coefficient.mouthFrownLeft", "arkit.coefficient.mouthFrownRight", "arkit.coefficient.mouthFunnel", "arkit.coefficient.mouthLeft", "arkit.coefficient.mouthLowerDownLeft", "arkit.coefficient.mouthLowerDownRight", "arkit.coefficient.mouthPressLeft", "arkit.coefficient.mouthPressRight", "arkit.coefficient.mouthPucker", "arkit.coefficient.mouthRight", "arkit.coefficient.mouthRollLower", "arkit.coefficient.mouthRollUpper", "arkit.coefficient.mouthShrugLower", "arkit.coefficient.mouthShrugUpper", "arkit.coefficient.mouthSmileLeft", "arkit.coefficient.mouthSmileRight", "arkit.coefficient.mouthStretchLeft", "arkit.coefficient.mouthStretchRight", "arkit.coefficient.mouthUpperUpLeft", "arkit.coefficient.mouthUpperUpRight", "arkit.coefficient.noseSneerLeft", "arkit.coefficient.noseSneerRight"]
reference_rig = "ICT-FaceKit Light (ICT-VGL/ICT-FaceKit da5f95a): generic neutral plus identity modes"
code_commit = "7cd8ff930702b9a864b5c3358260bc6c542cd796"
licence = "CC-BY-SA-4.0"
limitations = [
  "Software renders of two example rigs only: it calibrates how ICT-FaceKit and Rocketbox Female render ARKit names, not any tracker or any real face.",
  "ICT-FaceKit is the reference by choice, not ground truth; another reference rig would give other curves.",
  "Held out by one ICT identity: ICT expression shapes are identity-independent deltas, so the held-out identity tests face shape, framing and visibility, not how different people make an expression.",
  "Rocketbox Female is one avatar, so the curves do not transfer to other Rocketbox avatars; Rocketbox Male was never loaded (reserved as an unseen rig for the MediaPipe method).",
  "Landmarks are hand-picked or rule-based on untextured meshes (examples/data/rig_landmarks.json); Rocketbox has no brow geometry, so its brow points are placements.",
  "ICT's eyeLook shapes move only the eyelids (its eyeballs rotate separately), while Rocketbox's move the eyeballs, so the gaze channels compare different motions.",
  "mouthClose is evaluated on its own, where it presses already closed lips together; ARKit defines it together with jawOpen, which this fit does not test.",
  "Errors are in Rocketbox weight against the best-matching Rocketbox weight per condition; a passing shape can still differ in shape up to the match threshold (half the motion explained).",
  "The neutral error is zero by construction: both rigs are linear blend shapes and every curve starts at [0, 0].",
  "A monotone curve per shape cannot fix shapes that move different regions or directions, or that Rocketbox cannot reach; those fail as published negative results.",
  "Rendered on one machine (renderer table); images, and so metrics, may differ slightly on another OS or GPU.",
]

