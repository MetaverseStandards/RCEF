[training]
conditions = 270
description = "The 15 viseme shapes of each of the 18 training rigs (Female_Adult_01, _04, _06, _08, _10, _12, _13, _14, _17, Male_Adult_01, _02, _03, _05, _10, _11, _13, _17 and _19) at weight 1, fitted once per class over all rigs, each rig without its tongue (21 to 27 vertices). Shape residual |viseme - fit| / |viseme| after rounding, median/largest over the training rigs: vowel_open 0.286/0.300, vowel_mid_spread 0.605/0.633, vowel_close_spread 0.369/0.397, vowel_mid_rounded 0.303/0.317, vowel_close_rounded 0.678/0.914, bilabial 0.733/0.804, labiodental 0.909/0.930, dental 0.251/0.259, alveolar_sibilant 0.648/0.757, postalveolar 0.456/0.504, coronal_stop 0.285/0.295, coronal_nasal_lateral 0.521/0.536, dorsal 0.329/0.396, rhotic 0.554/0.589, sil 0.000/0.000 (sil does not move the face). Largest feature error over the training rigs (mm or ratio; range features: outside the range): bilabial: lip_opening_mm 0.000, lip_protrusion_mm 0.079; vowel_close_rounded: corner_width_ratio 0.024, lip_protrusion_mm 0.259; vowel_mid_spread: corner_width_ratio 0.087, lip_opening_mm 0.361; alveolar_sibilant: lip_opening_mm 0.566, jaw_drop_mm 0.001."

[held_out]
seed_rule = "rcef.calibration.seeds/1"
count = 24
frozen_sha256 = "ddde4315edf7071c85293b94641191983f59091107ceb4b70f0c9eb7c926c9c1"

[evaluation]
min_conditions = 24

[evaluation.bounds."rcef.canonical_viseme.vowel_open"]
median = 0.5
p95 = 0.5
neutral = 0.01

[evaluation.bounds."rcef.canonical_viseme.vowel_mid_spread"]
median = 0.5
p95 = 0.5
neutral = 0.01

[evaluation.bounds."rcef.canonical_viseme.vowel_close_spread"]
