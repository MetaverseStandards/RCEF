[[features]]
channel = "rcef.canonical_viseme.bilabial"
feature = "lip_opening_mm"
kind = "range"
units = "mm"
low = -2.0
high = 0.5
tolerance = 0.0
description = "signed vertical opening of the lips on the mid line, in mm: the lowest upper-lip landmark minus the highest lower-lip landmark (negative when the inner edges overlap)"

[[features]]
channel = "rcef.canonical_viseme.bilabial"
feature = "lip_protrusion_mm"
kind = "difference"
units = "mm"
tolerance = 0.5
description = "forward movement of the mid-line lip landmarks from neutral, mean, in mm"

[[features]]
channel = "rcef.canonical_viseme.bilabial"
feature = "whole_face_error"
kind = "range"
units = "1"
low = 0.0
high = 1.0
tolerance = 0.0
description = "the whole-mesh shape error of the condition (as in the shape cells); at most 1 means the reconstruction is no further from the target than the neutral face is"

[[features]]
channel = "rcef.canonical_viseme.vowel_close_rounded"
feature = "corner_width_ratio"
kind = "difference"
units = "1"
tolerance = 0.041
description = "distance between the two mouth-corner landmarks, divided by the neutral distance"

[[features]]
channel = "rcef.canonical_viseme.vowel_close_rounded"
feature = "lip_protrusion_mm"
kind = "difference"
units = "mm"
tolerance = 0.732
description = "forward movement of the mid-line lip landmarks from neutral, mean, in mm"

[[features]]
channel = "rcef.canonical_viseme.vowel_close_rounded"
feature = "whole_face_error"
kind = "range"
units = "1"
low = 0.0
high = 1.0
tolerance = 0.0
description = "the whole-mesh shape error of the condition (as in the shape cells); at most 1 means the reconstruction is no further from the target than the neutral face is"

[[features]]
channel = "rcef.canonical_viseme.vowel_mid_spread"
feature = "corner_width_ratio"
kind = "difference"
units = "1"
tolerance = 0.197
description = "distance between the two mouth-corner landmarks, divided by the neutral distance"

[[features]]
channel = "rcef.canonical_viseme.vowel_mid_spread"
feature = "lip_opening_mm"
kind = "difference"
units = "mm"
tolerance = 0.779
description = "signed vertical opening of the lips on the mid line, in mm: the lowest upper-lip landmark minus the highest lower-lip landmark (negative when the inner edges overlap)"

[[features]]
channel = "rcef.canonical_viseme.vowel_mid_spread"
feature = "whole_face_error"
kind = "range"
units = "1"
low = 0.0
high = 1.0
tolerance = 0.0
description = "the whole-mesh shape error of the condition (as in the shape cells); at most 1 means the reconstruction is no further from the target than the neutral face is"

[[features]]
channel = "rcef.canonical_viseme.alveolar_sibilant"
feature = "lip_opening_mm"
kind = "difference"
units = "mm"
tolerance = 2.35
description = "signed vertical opening of the lips on the mid line, in mm: the lowest upper-lip landmark minus the highest lower-lip landmark (negative when the inner edges overlap)"

[[features]]
channel = "rcef.canonical_viseme.alveolar_sibilant"
feature = "jaw_drop_mm"
kind = "difference"
units = "mm"
tolerance = 0.5
description = "downward movement of the lower-teeth landmarks from neutral, mean, in mm"

[[features]]
channel = "rcef.canonical_viseme.alveolar_sibilant"
feature = "whole_face_error"
kind = "range"
units = "1"
low = 0.0
high = 1.0
tolerance = 0.0
description = "the whole-mesh shape error of the condition (as in the shape cells); at most 1 means the reconstruction is no further from the target than the neutral face is"

