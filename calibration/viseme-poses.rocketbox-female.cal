# SPDX-License-Identifier: CC-BY-SA-4.0
# Written by tools/calibration/viseme_poses.py. Everything but cells was frozen, and its hash written to
# calibration/FREEZES, before the held-out run.
format = "rcef.calibration/1"
id = "viseme-poses.rocketbox-female"
version = 1
status = "calibrated_software"
scope = "software-only; not a measurement of any tracker"
method = "bounded_least_squares_pose_fit: for each Rocketbox Female viseme shape, the ARKit weights in [0, 1] that minimise the squared vertex distance to it over every vertex except the tongue (the vertices that tongueOut moves by more than 1% of its largest move), with the 37 ARKit shapes of the groups face, cheek_puff, jaw_thrust and chin_raise_upper_lip, each Left and Right pair sharing one weight; cyclic coordinate descent on the normal equations to a change below 1e-13, rounded to 3 decimals, and carried to canonical signals by the ARKit in-maps. Each curve gives the canonical value at class weight 1. Cell error: |reconstruction - target| / |target - neutral| over Rocketbox Male's vertices except the tongue, where the target is Male's own viseme shapes and the reconstruction is Male's ARKit shapes at the weights that the ARKit out-maps give for clamp(sum of pose times class weight, 0, 1); neutral is that error at weight 0. A condition is a failure if Male has no shape for the class, or if the target does not move the face but the reconstruction does; its error counts as 1."
channels = ["rcef.canonical_viseme.vowel_open", "rcef.canonical_viseme.vowel_mid_spread", "rcef.canonical_viseme.vowel_close_spread", "rcef.canonical_viseme.vowel_mid_rounded", "rcef.canonical_viseme.vowel_close_rounded", "rcef.canonical_viseme.bilabial", "rcef.canonical_viseme.labiodental", "rcef.canonical_viseme.dental", "rcef.canonical_viseme.alveolar_sibilant", "rcef.canonical_viseme.postalveolar", "rcef.canonical_viseme.coronal_stop", "rcef.canonical_viseme.coronal_nasal_lateral", "rcef.canonical_viseme.dorsal", "rcef.canonical_viseme.rhotic", "rcef.canonical_viseme.sil"]
reference_rig = "Microsoft Rocketbox Female_Adult_01 facial FBX (0943055): its 15 viseme shapes and 52 ARKit shapes on one mesh"
code_commit = "d7e0f507c65de73f332bd398b83156ed1ed98f9a"
licence = "CC-BY-SA-4.0"
limitations = [
  "Software-only geometry of two example rigs: the poses are Rocketbox Female's sculpted viseme shapes measured in her own ARKit shapes. They say nothing about any tracker, any real face or how people articulate.",
  "Rocketbox Female and Male come from one library, and their ARKit shapes were authored by the same team, so agreement on Male may partly reflect shared authoring rather than transfer to independent rigs.",
  "Teeth and tongue are not represented: the tongue is left out of the fit and of the error, tongueOut is not in the basis, and the teeth count only as part of the face mesh that moves with the jaw.",
  "The poses write no blink, gaze, jaw_sideways, mouth_shift or tongue_out values: those shapes are not in the basis. The fit is mirror-symmetric, so a pose moves both sides equally, although the training visemes are not exactly symmetric and Rocketbox Female's Left and Right ARKit shapes are not mirror images.",
  "Coarticulation is not modelled: each class is one static pose, and a blend of classes is the clamped sum of their poses.",
  "The weights are bounded to [0, 1] by design; whatever viseme motion the 37 ARKit shapes cannot reach that way is lost, and it shows as the error.",
  "Rocketbox morph targets are linear and the poses are summed linearly below the clamp, so the error of a class alone is the same at every weight; the weight and sil-blend conditions check the clamp and the rest blend, and the result at full weight decides.",
  "The error is a ratio of Euclidean norms over all vertices except the tongue, so it weighs every vertex equally: large-area motion of the jaw and chin counts more than small lip details.",
  "Other rigs render the same ARKit weight differently (record rig-gains.ict-rocketbox-female), so on another rig the poses give other geometry.",
  "Earlier tools rendered Rocketbox Male's shapes (examples/viseme_pipeline.py and the MediaPipe record), but no Male geometry was used for this fit or its bounds.",
]

[[inputs]]
name = "Microsoft Rocketbox Female_Adult_01_facial.fbx"
sha256 = "2e6ba71fb83a6899e3d4dd35da07fb5b078eef0c4d593f73d70cfc05dc4644cb"

[[inputs]]
name = "Microsoft Rocketbox Male_Adult_01_facial.fbx"
sha256 = "55771cbbcffb8204dcfe450784c8439ee27bfa48efffc48d325b55ee4bd04388"

[[inputs]]
name = "Microsoft Rocketbox LICENSE.md"
sha256 = "17474e386e0b9e1a700cc3d06b2b0882a2c376d9c6b49c7f8274409b8f8d2352"

[[inputs]]
name = "RCEF generated/rcef.pack.json (the ARKit in-maps and out-maps)"
sha256 = "b444b378ca4a923c81700b6f0bdb3a33e79127ec2314c57c402f63b8e04b7a33"

[training]
conditions = 15
description = "Each of Rocketbox Female's 15 viseme shapes at weight 1, fitted once, over 24 fewer vertices than the mesh (the tongue). Residual |viseme - fit| / |viseme| after rounding: vowel_open 0.281, vowel_mid_spread 0.585, vowel_close_spread 0.383, vowel_mid_rounded 0.313, vowel_close_rounded 0.529, bilabial 0.617, labiodental 0.901, dental 0.240, alveolar_sibilant 0.649, postalveolar 0.438, coronal_stop 0.290, coronal_nasal_lateral 0.501, dorsal 0.306, rhotic 0.503, sil 0.000 (sil does not move the face)."

[held_out]
seed_rule = "rcef.calibration.seeds/1"
count = 24
frozen_sha256 = "62eef93078e22288acbc1bcb03c5c284e2d05ad98236dc6809f90b1acc55e9cb"

[evaluation]
min_conditions = 24

[evaluation.bounds."rcef.canonical_viseme.vowel_open"]
