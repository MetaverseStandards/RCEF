[training]
conditions = 150
description = "The 15 viseme shapes of each of the 10 training rigs (Female_Adult_01, _08, _10, _12, _14, Male_Adult_01, _03, _10, _13 and _17) at weight 1, fitted once per class over all rigs, each rig without its tongue (21 to 24 vertices). Residual |viseme - fit| / |viseme| after rounding, median/largest over the training rigs: vowel_open 0.286/0.298, vowel_mid_spread 0.554/0.584, vowel_close_spread 0.365/0.384, vowel_mid_rounded 0.302/0.312, vowel_close_rounded 0.578/0.587, bilabial 0.618/0.675, labiodental 0.899/0.911, dental 0.214/0.217, alveolar_sibilant 0.636/0.643, postalveolar 0.452/0.479, coronal_stop 0.275/0.284, coronal_nasal_lateral 0.502/0.519, dorsal 0.332/0.396, rhotic 0.493/0.504, sil 0.000/0.000 (sil does not move the face)."

[held_out]
seed_rule = "rcef.calibration.seeds/1"
count = 24
frozen_sha256 = "2693e7aab6b06556d760d41e7aa0104408fe92d7e01e0fe3a5bacaa6f88460b3"

