# SPDX-License-Identifier: CC-BY-SA-4.0
# Written by tools/calibration/viseme_poses.py. Everything but cells was frozen, and its hash written to
# calibration/FREEZES, before the held-out run.
format = "rcef.calibration/1"
id = "viseme-poses.rocketbox-multi"
version = 1
status = "calibrated_software"
scope = "software-only; not a measurement of any tracker"
method = "minimax_bounded_least_squares_pose_fit: for each canonical viseme class, one set of ARKit weights in [0, 1] for all training rigs, from the 37 ARKit shapes of the groups face, cheek_puff, jaw_thrust and chin_raise_upper_lip, Left and Right apart. On each training rig the error is |fit - viseme| / |viseme| over the vertex displacements of every vertex except the tongue (the vertices that the rig's tongueOut moves by more than 1% of its largest move). The fit approaches the weights with the smallest largest error by Lawson reweighting: 100 rounds of bounded least squares on the sum of rig weight times squared error, each rig weight starting at 1 and then multiplied by its error and normalised; each round by cyclic coordinate descent on the normal equations to a change below 1e-13. The weights are rounded to 3 decimals and carried to canonical signals by the ARKit in-maps. Each curve gives the canonical value at class weight 1. This method was chosen over a single-rig fit, a sum of squared errors, a mirror-symmetric fit and a lip-region weighting by leave-one-rig-out cross-validation within the training rigs. Cell error, one cell per class and held-out rig: |reconstruction - target| / |target - neutral| over the rig's vertices except the tongue, where the target is the rig's own viseme shapes and the reconstruction is the rig's ARKit shapes at the weights that the ARKit out-maps give for clamp(sum of pose times class weight, 0, 1); neutral is that error at weight 0. A condition is a failure if the rig has no shape for the class, or if the target does not move the face but the reconstruction does; its error counts as 1. A class passes if its cells pass on every held-out rig. Use: the viseme pose bridge is written from this record alone and reads exactly the classes that pass; it replaces viseme-poses.rocketbox-female for every class, whether more or fewer classes pass."
channels = ["rcef.canonical_viseme.vowel_open", "rcef.canonical_viseme.vowel_mid_spread", "rcef.canonical_viseme.vowel_close_spread", "rcef.canonical_viseme.vowel_mid_rounded", "rcef.canonical_viseme.vowel_close_rounded", "rcef.canonical_viseme.bilabial", "rcef.canonical_viseme.labiodental", "rcef.canonical_viseme.dental", "rcef.canonical_viseme.alveolar_sibilant", "rcef.canonical_viseme.postalveolar", "rcef.canonical_viseme.coronal_stop", "rcef.canonical_viseme.coronal_nasal_lateral", "rcef.canonical_viseme.dorsal", "rcef.canonical_viseme.rhotic", "rcef.canonical_viseme.sil"]
reference_rig = "Microsoft Rocketbox facial FBX files (0943055) of the 10 training rigs Female_Adult_01, _08, _10, _12, _14, Male_Adult_01, _03, _10, _13 and _17: each has 15 viseme shapes and 52 ARKit shapes on one mesh. Held out: Female_Adult_04, _13, Male_Adult_05 and _11. Rig sets by the rule in tools/calibration/viseme_rigs.json"
code_commit = "ce56bb61b630a0ec1bbcefb7d7516a697c6f303e"
licence = "CC-BY-SA-4.0"
limitations = [
  "Software-only geometry of example rigs: the poses are the sculpted viseme shapes of 10 Rocketbox rigs measured in their own ARKit shapes. They say nothing about any tracker, any real face or how people articulate.",
  "All training and held-out rigs come from one library, and their viseme and ARKit shapes were authored by the same team, so agreement on the held-out rigs may partly reflect shared authoring rather than transfer to independent rigs.",
  "Teeth and tongue are not represented: the tongue is left out of the fit and of the error, tongueOut is not in the basis, and the teeth count only as part of the face mesh that moves with the jaw.",
  "The poses write no blink, gaze, jaw_sideways, mouth_shift or tongue_out values: those shapes are not in the basis. Left and Right shapes have their own weights, so a pose may move the two sides by slightly different amounts, as the training rigs do.",
  "Coarticulation is not modelled: each class is one static pose, and a blend of classes is the clamped sum of their poses.",
  "The weights are bounded to [0, 1] by design; whatever viseme motion the 37 ARKit shapes cannot reach that way is lost, and it shows as the error. For some classes this is more than half of the motion even on the training rigs (see training).",
  "Rocketbox morph targets are linear and the poses are summed linearly below the clamp, so the error of a class alone is the same at every weight; the weight and sil-blend conditions check the clamp and the rest blend, and the result at full weight decides.",
  "The error is a ratio of Euclidean norms over all vertices except the tongue, so it weighs every vertex equally: large-area motion of the jaw and chin counts more than small lip details.",
  "The fit makes the worst training rig as good as it can, so one unusual training rig can pull a pose away from what suits the others; Lawson reweighting stops after a fixed number of rounds, near the minimax fit.",
  "Rigs from other libraries render the same ARKit weight differently (record rig-gains.ict-rocketbox-female), so on such a rig the poses give other geometry.",
  "Rocketbox Male_Adult_01 was the held-out rig of viseme-poses.rocketbox-female and is a training rig here. No earlier record or tool loaded the four held-out rigs.",
]

