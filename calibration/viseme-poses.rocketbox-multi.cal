[training]
conditions = 150
description = "The 15 viseme shapes of each of the 10 training rigs (Female_Adult_01, _08, _10, _12, _14, Male_Adult_01, _03, _10, _13 and _17) at weight 1, fitted once per class over all rigs, each rig without its tongue (21 to 24 vertices). Residual |viseme - fit| / |viseme| after rounding, median/largest over the training rigs: vowel_open 0.288/0.300, vowel_mid_spread 0.561/0.588, vowel_close_spread 0.371/0.389, vowel_mid_rounded 0.307/0.317, vowel_close_rounded 0.584/0.594, bilabial 0.633/0.687, labiodental 0.902/0.913, dental 0.254/0.257, alveolar_sibilant 0.650/0.655, postalveolar 0.453/0.479, coronal_stop 0.285/0.295, coronal_nasal_lateral 0.517/0.535, dorsal 0.332/0.396, rhotic 0.563/0.589, sil 0.000/0.000 (sil does not move the face)."

[held_out]
seed_rule = "rcef.calibration.seeds/1"
count = 24
frozen_sha256 = "fd3313683812bb08c1d1106109840e2a2bd503e045b94aa9f138560f6f293433"

[evaluation]
