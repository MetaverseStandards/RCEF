# SPDX-License-Identifier: CC-BY-SA-4.0
# RCEF calibration record (format: calibration/README.md). TEST FIXTURE: every
# number and hash here is invented to exercise check.py; nothing was measured.
# A geometry-only fit, so it has no renderer.
format = "rcef.calibration/1"
id = "fixture.poses"
version = 1
status = "calibrated_software"
scope = "software-only; not a measurement of any tracker"
method = "pose_fit"
channels = ["fixture.source.jaw", "fixture.source.lip"]
reference_rig = "Fixture rig (synthetic)"
code_commit = "0123456789abcdef0123456789abcdef01234567"
licence = "CC-BY-SA-4.0"
limitations = [
  "Synthetic test fixture; it describes no real fit.",
]

[[inputs]]
name = "fixture-rig.glb"
sha256 = "1111111111111111111111111111111111111111111111111111111111111111"

[training]
conditions = 2
description = "Each fixture source shape fitted once."

[held_out]
seed_rule = "rcef.calibration.seeds/1"
count = 24
frozen_sha256 = "828caa0d591460c27a6dbd22f839b26905bfcb40be2fb3a4864201084f570e39"

[evaluation]
min_conditions = 24

[evaluation.bounds."fixture.source.jaw"]
median = 0.5
p95 = 0.5
neutral = 0.01

[evaluation.bounds."fixture.source.lip"]
median = 0.5
p95 = 0.5
neutral = 0.01

[[curves]]
input = "fixture.source.jaw"
output = "fixture.target.jaw"
knots = [[0.0, 0.0], [1.0, 0.4]]

[[curves]]
input = "fixture.source.lip"
output = "fixture.target.jaw"
knots = [[0.0, 0.0], [1.0, 0.25]]

[[cells]]
channel = "fixture.source.jaw"
side = "shared"
stimulus = "class weight"
identity = "fixture rig 2"
conditions = 24
failures = 0
median = 0.2
p95 = 0.3
neutral = 0.0

[[cells]]
channel = "fixture.source.lip"
side = "shared"
stimulus = "class weight"
identity = "fixture rig 2"
conditions = 24
failures = 0
median = 0.3
p95 = 0.4
neutral = 0.0
